{
  "name": "open-realms",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Open Realms: read-only governance explorer for SPL Governance with rule-based risk checks, VSR voting power and Telegram alerts.",
  "engines": {
    "node": ">=18.19 <23"
  },
  "scripts": {
    "dev": "next dev lens -p 3100",
    "build": "next build lens",
    "start": "node lens/scripts/start.js",
    "offline": "node lens/scripts/start.js --offline",
    "snapshot": "node lens/scripts/snapshot.js",
    "bot": "ts-node -P bots/telegram/tsconfig.json bots/telegram/index.ts",
    "test": "jest",
    "type-check": "tsc --noEmit -p lens/tsconfig.json"
  },
  "dependencies": {
    "@solana/spl-governance": "0.3.28",
    "@solana/web3.js": "1.78.8",
    "bn.js": "5.1.3",
    "next": "12.3.6",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@coral-xyz/anchor": "0.29.0",
    "@solana/spl-token": "0.1.8",
    "@types/bn.js": "5.1.0",
    "@types/jest": "29.2.0",
    "@types/node": "20.14.10",
    "@types/react": "18.2.14",
    "jest": "29.2.0",
    "ts-jest": "29.0.3",
    "ts-node": "10.9.1",
    "typescript": "5.5.4"
  },
  "overrides": {
    "rpc-websockets": "7.11.0"
  }
}
