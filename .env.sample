# Copy to .env (gitignored) and fill in. Never commit .env, never print or log its values.

# --- Open Realms site (lens/) -------------------------------------------------
# Server-side Solana mainnet RPC (e.g. a Helius URL with your key). Read by the
# server only, never sent to the browser. Without it the public RPC is used and
# it rate-limits (HTTP 429).
RPC_UPSTREAM=
# Alias, used if RPC_UPSTREAM is empty
# BACKEND_MAINNET_RPC=

# Realm pre-loaded by /api/warm at start-up (symbol or address)
# LENS_FEATURED_REALM=MNDE
# Skip the start-up warm-up
# LENS_NO_WARM=1
# Serve only lens/demo-data and never call RPC (same as `npm run offline`)
# LENS_OFFLINE=1
# Telegram bot username shown on the site (without @)
# LENS_TELEGRAM_BOT=solanacze_sam_bot
# Optional link to a full voting UI, and the source link in the footer
# NEXT_PUBLIC_FULL_UI_URL=
# NEXT_PUBLIC_SOURCE_URL=https://github.com/qqxzew/governance-ui
# Self-contained server bundle for small hosts (NEXT_STANDALONE=1 npm run build)
# NEXT_STANDALONE=1
# PORT=3100

# --- Telegram bot (bots/telegram, see bots/telegram/README.md) ----------------
# From @BotFather. Treat it as a password.
TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids allowed to use the bot (empty = anyone)
TELEGRAM_ALLOWED_CHATS=
# BOT_RPC_URL=https://api.mainnet-beta.solana.com
# BOT_POLL_SECONDS=60
# APP_URL=http://localhost:3100
