# Run in context of one realm: starts with default realm and disables realms page navigation
# REALM=MNGO
MAINNET_RPC=https://mango.rpcpool.com
DEVNET_RPC=https://mango.devnet.rpcpool.com

DEFAULT_GOVERNANCE_PROGRAM_ID=GTesTBiEWE32WHXXE2S4XbZvA5CrEc4xs6ZgRe895dP

NEXT_PUBLIC_JUPTER_SWAP_API_ENDPOINT=https://quote-api.jup.ag/v6
NEXT_PUBLIC_API_ENDPOINT=https://api.realms.today/graphql
NEXT_PUBLIC_DISCORD_APPLICATION_CLIENT_ID=1042836142560645130
NEXT_PUBLIC_DISCORD_MATCHDAY_CLIENT_ID=1044361939322683442
NEXT_PUBLIC_HELIUS_MAINNET_RPC=
NEXT_PUBLIC_HELIUS_DEVNET_RPC=

# Telegram proposal bot (bots/telegram, see bots/telegram/README.md). Never commit the token.
TELEGRAM_BOT_TOKEN=
# Optional: comma-separated chat ids allowed to use the bot (empty = anyone)
TELEGRAM_ALLOWED_CHATS=
# BOT_RPC_URL=https://api.mainnet-beta.solana.com
# BOT_POLL_SECONDS=60
# APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Fork / demo settings (see README-DEMO.md). Copy this file to .env and edit.
# Never commit .env.
# ---------------------------------------------------------------------------
# Browser-side mainnet RPC. The public RPC rejects browser requests (403 on the
# Origin header), so point this at the local proxy (`yarn rpc:live`) or at a
# provider URL with your own key (e.g. Helius).
# NEXT_PUBLIC_MAINNET_RPC=http://localhost:8898
# NEXT_PUBLIC_DEVNET_RPC=https://api.devnet.solana.com

# true = never sign/send transactions on mainnet (demo builds). Devnet and the
# local validator (127.0.0.1:8899) stay writable.
NEXT_PUBLIC_READ_ONLY_MAINNET=true

# Pin the UI to one realm (Marinade DAO).
# REALM=MNDE

# rpc-proxy (scripts/rpc-proxy.js) options; CLI flags override these.
# UPSTREAM=https://mainnet.helius-rpc.com/?api-key=<your-key>
# RPC_PROXY_MODE=live            # live | record | replay
# RPC_SNAPSHOT=demo/snapshot/rpc.json

# Build output dir (lets `next build` run next to a running `next dev`).
# NEXT_DIST_DIR=.next-build
